{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build C++20",
            "command": "D:\\Users\\mingw64\\bin\\g++.exe",
            "args": [
                "-std=c++20",
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build"
            },
            "detail": "Build a single C++ file with g++ using C++20"
        },
        {
            "label": "Build C++ module project",
            "type": "shell",
            "command": "D:\\Users\\mingw64\\bin\\g++.exe",
            "args": [
                "-std=c++20",
                "-fmodules-ts",
                "-fdiagnostics-color=always",
                "-g",
                "foo.cxx",
                "use.cpp",
                "-o",
                "program.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}